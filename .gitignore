# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# python
__pycache__/
*.pyc
.pytest_cache/
# minder runtime artifacts
*.zst
dumps/
# local databases must never be committed, wherever they sprout
# (default state dir is $HOME, but MINDER_STATE_DIR=. would land here)
*.sqlite
*.sqlite-wal
*.sqlite-shm
# P7 offline training exports — research input only, never committed
memory/exports/
# operator-plane benchmark state — pinned baselines & run reports are
# operator-local; manifests and task fixtures stay tracked
benchmarks/baselines/
benchmarks/reports/

# local tooling / personal artifacts — never published
.zcode/
.ignore
opencode.json
.env*
*.bak
# project docs are local-private by default (retracted from the
# public repo 2026-09-23; snapshot: ~/minder-docs-private-20260923.tar.gz).
# Only the user-facing usage docs are published:
docs/*
!docs/operator-cli.md
!docs/operator-web.md

# injected by local audit hooks — generic agent scaffolding, not project code
.agentic/
CLAUDE.md
