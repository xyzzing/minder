[Unit]
Description=minder capture daily digest (issues #73, #94)

[Service]
Environment=PATH=%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
Type=oneshot
ExecStart=%h/projects/minder/scripts/minder-capture-canary.sh --fast --digest
MemoryMax=512M
CPUQuota=25%
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=120
KillMode=control-group
